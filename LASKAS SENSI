<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel Control Center - Simulator</title>
  
  <!-- Fonte Orbitron -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #0b0314;
      --card-bg: #160a29;
      --accent-purple: #9d4edd;
      --accent-glow: #c77dff;
      --neon-cyan: #00f5d4;
      --danger-red: #ff0055;
      --text-color: #e0aaff;
      --font-orbitron: 'Orbitron', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: var(--font-orbitron);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      background-image: 
        radial-gradient(circle at 50% 10%, rgba(157, 78, 221, 0.15), transparent 60%),
        radial-gradient(circle at 80% 80%, rgba(0, 245, 212, 0.05), transparent 50%);
    }

    /* Standard Container */
    .panel-container {
      width: 100%;
      max-width: 480px;
      background: var(--card-bg);
      border: 2px solid var(--accent-purple);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 0 25px rgba(157, 78, 221, 0.3);
      position: relative;
      overflow: hidden;
    }

    /* Header */
    .panel-header {
      text-align: center;
      margin-bottom: 24px;
      border-bottom: 1px solid rgba(157, 78, 221, 0.3);
      padding-bottom: 12px;
    }

    .panel-title {
      font-size: 1.5rem;
      font-weight: 900;
      color: #fff;
      text-shadow: 0 0 10px var(--accent-glow);
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    /* Modal / Auth Screen */
    .login-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(11, 3, 20, 0.95);
      backdrop-filter: blur(8px);
      z-index: 100;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .login-box {
      width: 100%;
      max-width: 320px;
      text-align: center;
    }

    .input-field {
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--accent-purple);
      border-radius: 8px;
      color: #fff;
      font-family: var(--font-orbitron);
      text-align: center;
      outline: none;
      transition: all 0.3s;
    }

    .input-field:focus {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 10px rgba(0, 245, 212, 0.4);
    }

    /* Buttons */
    .btn {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
      background: linear-gradient(135deg, #7b2cbf, #5a189a);
      border: none;
      border-radius: 8px;
      color: #fff;
      font-family: var(--font-orbitron);
      font-weight: 700;
      text-transform: uppercase;
      cursor: pointer;
      letter-spacing: 1px;
      transition: all 0.2s;
      box-shadow: 0 4px 15px rgba(123, 44, 191, 0.4);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(199, 125, 255, 0.6);
    }

    .btn:active {
      transform: translateY(0);
    }

    /* Section Styles */
    .section-title {
      font-size: 0.9rem;
      color: var(--neon-cyan);
      margin: 16px 0 10px 0;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Toggle Switches Grid */
    .toggle-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .toggle-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(157, 78, 221, 0.2);
      border-radius: 10px;
      padding: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: 0.3s;
    }

    .toggle-card.active {
      border-color: var(--neon-cyan);
      background: rgba(0, 245, 212, 0.05);
    }

    .toggle-label {
      font-size: 0.8rem;
      font-weight: 700;
    }

    /* Switch Component */
    .switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 22px;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: #2b1b40;
      transition: .3s;
      border-radius: 22px;
      border: 1px solid var(--accent-purple);
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 14px;
      width: 14px;
      left: 3px;
      bottom: 3px;
      background-color: #fff;
      transition: .3s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--accent-purple);
      border-color: var(--neon-cyan);
    }

    input:checked + .slider:before {
      transform: translateX(22px);
      background-color: var(--neon-cyan);
      box-shadow: 0 0 8px var(--neon-cyan);
    }

    /* Weapon Cards */
    .weapon-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .weapon-card {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(157, 78, 221, 0.3);
      border-radius: 10px;
      padding: 10px;
      text-align: center;
      position: relative;
    }

    .weapon-icon {
      width: 100%;
      height: 45px;
      object-fit: contain;
      margin: 6px 0;
      filter: drop-shadow(0 0 5px var(--accent-purple));
    }

    .weapon-name {
      font-size: 0.75rem;
      color: #fff;
      margin-bottom: 6px;
    }

    /* Double SOSN Toggle Effect */
    .double-sosn-btn {
      width: 100%;
      padding: 12px;
      margin: 16px 0 8px 0;
      background: transparent;
      border: 2px dashed var(--accent-glow);
      color: var(--accent-glow);
      border-radius: 8px;
      font-family: var(--font-orbitron);
      font-weight: 700;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: all 0.3s;
    }

    .double-sosn-btn.active {
      background: rgba(199, 125, 255, 0.15);
      border-style: solid;
      box-shadow: 0 0 15px var(--accent-purple);
      animation: doublePulse 1.5s infinite alternate;
    }

    @keyframes doublePulse {
      0% { border-color: var(--accent-glow); box-shadow: 0 0 5px var(--accent-glow); }
      100% { border-color: var(--neon-cyan); box-shadow: 0 0 18px var(--neon-cyan); }
    }

    /* C++ & Inject Buttons */
    .cpp-btn {
      background: #3a0ca3;
      border: 1px solid var(--accent-purple);
      font-size: 0.8rem;
    }

    .inject-btn {
      background: linear-gradient(135deg, #ff0055, #7209b7);
      margin-top: 12px;
      padding: 16px;
      font-size: 1rem;
      letter-spacing: 2px;
      box-shadow: 0 0 20px rgba(255, 0, 85, 0.4);
    }

    .inject-btn.active {
      background: linear-gradient(135deg, #00f5d4, #3a0ca3);
      box-shadow: 0 0 20px rgba(0, 245, 212, 0.6);
      color: #000;
    }

    /* Status Bar */
    .status-bar {
      margin-top: 15px;
      text-align: center;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.6);
    }

    .status-indicator {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #555;
      margin-right: 6px;
    }

    .status-indicator.online {
      background: var(--neon-cyan);
      box-shadow: 0 0 8px var(--neon-cyan);
    }
  </style>
</head>
<body>

  <div class="panel-container">
    
    <!-- Tela de Login / Senha -->
    <div class="login-overlay" id="loginModal">
      <div class="login-box">
        <h2 style="color: #fff; margin-bottom: 15px; font-size: 1.2rem;">SISTEMA DE AUTENTICAÇÃO</h2>
        <input type="password" id="passSosn" class="input-field" placeholder="Senha SOSN">
        <input type="password" id="passLaskas" class="input-field" placeholder="Senha LASKAS">
        <button class="btn" onclick="authenticate()">Acessar Painel</button>
        <p id="errorMsg" style="color: var(--danger-red); font-size: 0.75rem; margin-top: 10px; display: none;">Senhas incorretas!</p>
      </div>
    </div>

    <!-- Cabeçalho -->
    <div class="panel-header">
      <div class="panel-title">MAIN CONTROL PANEL</div>
      <p style="font-size: 0.65rem; color: var(--accent-glow); margin-top: 4px;">SYSTEM TUNING INTERFACE</p>
    </div>

    <!-- Seção Principal: Aim Controls -->
    <div class="section-title"><span>🎯</span> AIMBOT MAIN SETTINGS</div>
    <div class="toggle-grid">
      <div class="toggle-card">
        <span class="toggle-label">Aimbot</span>
        <label class="switch">
          <input type="checkbox" onchange="toggleSound(this)">
          <span class="slider"></span>
        </label>
      </div>
      <div class="toggle-card">
        <span class="toggle-label">Aimlock</span>
        <label class="switch">
          <input type="checkbox" onchange="toggleSound(this)">
          <span class="slider"></span>
        </label>
      </div>
      <div class="toggle-card">
        <span class="toggle-label">Aim Drag</span>
        <label class="switch">
          <input type="checkbox" onchange="toggleSound(this)">
          <span class="slider"></span>
        </label>
      </div>
      <div class="toggle-card">
        <span class="toggle-label">Aim Assist</span>
        <label class="switch">
          <input type="checkbox" onchange="toggleSound(this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <!-- Seção: No Recoil Armas -->
    <div class="section-title"><span>🔫</span> WEAPON NO-RECOIL CONFIG</div>
    <div class="weapon-grid">
      
      <!-- Card UMP -->
      <div class="weapon-card">
        <div class="weapon-name">UMP - NO RECOIL</div>
        <!-- Imagem SVG Ilustrativa da Arma -->
        <svg class="weapon-icon" viewBox="0 0 100 40" fill="none" stroke="var(--neon-cyan)" stroke-width="2">
          <path d="M10 25 L30 25 L40 15 L80 15 L85 22 L75 25 L35 25 L25 35 Z" />
          <rect x="45" y="25" width="6" height="10" fill="var(--accent-purple)"/>
        </svg>
        <label class="switch">
          <input type="checkbox" onchange="toggleSound(this)">
          <span class="slider"></span>
        </label>
      </div>

      <!-- Card MP40 -->
      <div class="weapon-card">
        <div class="weapon-name">MP40 - NO RECOIL</div>
        <svg class="weapon-icon" viewBox="0 0 100 40" fill="none" stroke="var(--neon-cyan)" stroke-width="2">
          <path d="M15 22 L35 22 L45 12 L85 12 L85 18 L70 22 L35 22 L20 32 Z" />
          <rect x="50" y="22" width="5" height="12" fill="var(--accent-purple)"/>
        </svg>
        <label class="switch">
          <input type="checkbox" onchange="toggleSound(this)">
          <span class="slider"></span>
        </label>
      </div>

    </div>

    <!-- Animação Dupla SOSN -->
    <button id="sosnDoubleBtn" class="double-sosn-btn" onclick="toggleSosnDouble()">
      MODO SOSN DUPLO: <span id="sosnStatus">DESLIGADO</span>
    </button>

    <!-- Botão C++ Mod -->
    <button class="btn cpp-btn" onclick="playBeep(600, 0.1)">C++ SYSTEM CORE ENGINE</button>

    <!-- Botão de Injeção -->
    <button id="injectBtn" class="btn inject-btn" onclick="triggerInjection()">
      INJECT FREE FIRE
    </button>

    <!-- Status -->
    <div class="status-bar">
      <span id="statusDot" class="status-indicator"></span>
      <span id="statusText">Status: Standby</span>
    </div>

  </div>

  <script>
    // Sintetizador de Áudio (Web Audio API) para emissão de som ao pressionar botões
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playBeep(frequency = 440, duration = 0.08) {
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.value = frequency;
      gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    // Feedback de Som ao Ligar / Desligar
    function toggleSound(checkbox) {
      if (checkbox.checked) {
        playBeep(880, 0.1); // Som agudo ao ligar
        checkbox.closest('.toggle-card')?.classList.add('active');
      } else {
        playBeep(330, 0.1); // Som grave ao desligar
        checkbox.closest('.toggle-card')?.classList.remove('active');
      }
    }

    // Validação de Senhas (sosn e LASKAS)
    function authenticate() {
      const sosnVal = document.getElementById('passSosn').value;
      const laskasVal = document.getElementById('passLaskas').value;
      const errorMsg = document.getElementById('errorMsg');

      // Verifica as credenciais informadas
      if (sosnVal.toLowerCase() === 'sosn' && laskasVal.toUpperCase() === 'LASKAS') {
        playBeep(1200, 0.2);
        document.getElementById('loginModal').style.display = 'none';
        document.getElementById('statusDot').classList.add('online');
        document.getElementById('statusText').innerText = 'Status: Autenticado';
      } else {
        playBeep(200, 0.25);
        errorMsg.style.display = 'block';
      }
    }

    // Alternar Animação Dupla SOSN
    let sosnActive = false;
    function toggleSosnDouble() {
      const btn = document.getElementById('sosnDoubleBtn');
      const statusText = document.getElementById('sosnStatus');
      
      sosnActive = !sosnActive;
      if (sosnActive) {
        playBeep(950, 0.12);
        btn.classList.add('active');
        statusText.innerText = 'LIGADO';
      } else {
        playBeep(400, 0.12);
        btn.classList.remove('active');
        statusText.innerText = 'DESLIGADO';
      }
    }

    // Ativação do Botão Inject Free Fire
    function triggerInjection() {
      const injectBtn = document.getElementById('injectBtn');
      const statusText = document.getElementById('statusText');

      playBeep(1000, 0.15);
      injectBtn.innerText = "INJECTING...";
      statusText.innerText = "Status: Otimizando configurações...";

      setTimeout(() => {
        playBeep(1500, 0.3);
        injectBtn.classList.add('active');
        injectBtn.innerText = "ACTIVATED!";
        statusText.innerText = "Status: Inject Free Fire Ativado!";
      }, 1200);
    }
  </script>
</body>
</html>
